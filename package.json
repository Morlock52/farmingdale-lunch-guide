{
  "name": "farmingdale-lunch-guide",
  "version": "1.0.0",
  "description": "A web-based restaurant discovery application for Farmingdale State College students",
  "main": "js/app.js",
  "scripts": {
    "start": "npx serve .",
    "lint": "eslint js/**/*.js",
    "lint:fix": "eslint js/**/*.js --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
